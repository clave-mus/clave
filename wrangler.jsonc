{
  // Publicar o Clave no Cloudflare Workers, servindo o site estático (`static assets`).
  //
  // **Por que Workers e não Pages.** O painel do Cloudflare passou a criar projetos novos por aqui, e
  // foi o que o fluxo ofereceu quando o projeto foi recriado — o Pages antigo tinha quebrado com a
  // transferência do repositório para a organização.
  //
  // ⚠️ **`public/_redirects` foi APAGADO, e não é opcional.** Eu tinha escrito aqui que ele era
  // "inofensivo" em Workers. Errado: o Workers **lê** o arquivo e **recusa o deploy** com
  // `Invalid _redirects configuration: infinite loop detected`, porque a regra do Pages
  // (`/* /index.html 200`) casa com o próprio `/index.html` e se morde. Quebrou o primeiro deploy.
  //
  // Quem faz o papel dele aqui é o `not_found_handling` abaixo — e **só ele**. Se um dia o projeto
  // voltar para o Pages, o `_redirects` volta junto; os dois nunca convivem.
  "name": "clave",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./dist/",
    // O Clave é uma aplicação de uma página só: `/rotina/x/fazer` não é um arquivo, é uma rota do
    // react-router. Sem isto, abrir um link direto (ou recarregar a página no meio de uma rotina)
    // devolve 404 — que é o jeito mais fácil de um link compartilhado morrer.
    "not_found_handling": "single-page-application"
  }
}
